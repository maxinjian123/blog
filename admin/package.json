{
  "name": "blog-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev-admin": "vite",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vue-tsc --noEmit && vite build && cross-env NODE_ENV=production electron-builder --win ",
    "electron:build:portable": "vue-tsc --noEmit && vite build && cross-env NODE_ENV=production electron-builder --win portable"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vavt/v3-extension": "^4.0.0",
    "@vueuse/core": "^12.0.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "highlight.js": "^11.11.1",
    "markdown-it-attrs": "^5.0.1",
    "marked": "^15.0.4",
    "md-editor-v3": "^6.5.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^3.0.1",
    "qface": "^1.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0",
    "wait-on": "^8.0.1"
  }
}
