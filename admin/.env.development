# .env.* 文件仅用于桌面端（Electron）应用配置，Web 端请使用系统设置中的站点地址(site_url)等动态配置
# VITE_APP_API_URL     — 客户端访问地址（仅桌面端使用；Web 端客户端地址请用「系统设置 → 站点信息 → 站点地址 site_url」）
# VITE_APP_BACKEND_URL — 后端 API 地址（桌面端连接后端 / 自定义页面预览）
NODE_ENV=development
VITE_APP_API_URL=http://localhost:5173
VITE_APP_BACKEND_URL=http://localhost:3000
VITE_APP_DEBUG=true
VITE_APP_MOCK=true
