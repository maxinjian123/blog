# 配置文件示例
# 注意：该文件会被 electron-builder 随桌面端一起打包，作为桌面端首次启动的默认配置模板。先配置好，再打包。
# .env.* 文件仅用于桌面端（Electron）应用配置，Web 端请使用系统设置中的站点地址(site_url)等动态配置
# 字段语义：
#   VITE_APP_API_URL      — 客户端访问地址（仅桌面端使用，用于生成文章链接，如 http://your-domain.com；Web 端请用系统设置 → 站点地址 site_url）
#   VITE_APP_BACKEND_URL  — 后端 API 地址（桌面端连接后端用，如 http://192.168.48.1:3000）
NODE_ENV=production
VITE_APP_API_URL=http://your-domain.com
VITE_APP_BACKEND_URL=http://192.168.48.1:3000
VITE_APP_DEBUG=false
VITE_APP_MOCK=false
