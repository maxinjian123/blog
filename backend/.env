# ============================================
# 3D Blog 项目环境变量配置文件
# 所有配置参数集中管理
# ============================================

# ---- 服务端口 ----
BACKEND_PORT=3000
FRONTEND_PORT=5173
ADMIN_PORT=5174

# ---- 数据库配置 (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog_3d
DB_USER=root
DB_PASSWORD=root

# ---- Redis 配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT 认证 ----
JWT_SECRET=39dd920c56024d4d952a9384763e60ab
JWT_EXPIRES_IN=7d

# ---- 豆包 AI 配置 (火山引擎) ----665-05a5-4260-8993-12b73925ee39-0e881
DOUBAO_API_KEY=ark-c3bfc665-05a5-4260-8993-12b73925ee39-0e881
# Chat 模型 (对话/创作/摘要/标签/问答等)ark-c3bfc
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-2-0-mini-260428

# 文生图模型 (封面图生成)
DOUBAO_IMAGE_MODEL=doubao-seedream-4-5-251128

# ---- Ollama 配置 (本地对话模型) ----
OLLAMA_HOST=http://localhost:11434

# Ollama 本地对话模型 (用于切换本地/云端模型)
# 设置为 true 启用本地模型，false 使用云端豆包模型
OLLAMA_CHAT_ENABLED=true
OLLAMA_CHAT_MODEL=glm4:9b

# ---- 应用配置 ----
NODE_ENV=proc
APP_NAME=TechMind Blog
ADMIN_EMAIL=2906594394@qq.com
ADMIN_PASSWORD=admin123

# ---- 文件上传 ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb

# ---- CORS ----
CORS_ORIGIN=