# ============================================
# Blog 项目环境变量配置文件
# ============================================

# ---- 服务端口 ----
BACKEND_PORT=3000
FRONTEND_PORT=5173
ADMIN_PORT=5174

# ---- 数据库配置 (MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=blog
DB_USER=root
DB_PASSWORD=root

# ---- Redis 配置 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT 认证 ----
JWT_SECRET=63b64dd0b35db56b00c7687a4c5af84d8e0d0d32e4fb5b93cfb9191e3cb5b42b
JWT_EXPIRES_IN=7d

# ---- 豆包 AI 配置 (火山引擎) ----
DOUBAO_API_KEY=ark-c3bfc665-05a5-4260-8993-12b73925ee39-0e881
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-2-0-mini-260428
DOUBAO_IMAGE_MODEL=doubao-seedream-4-5-251128

# ---- Ollama 配置 (本地对话模型) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_ENABLED=true
OLLAMA_CHAT_MODEL=glm4:9b

# ---- 环境与 CORS ----
NODE_ENV=proc
CORS_ORIGIN=

# ---- 评论回复邮件跳转链接前缀 ----
# 用于拼接评论回复通知邮件中"查看详情"按钮的地址：<COMMENT_REPLY_URL_PREFIX>/article/<id>
# 留空时回退到请求 host（开发环境自动用 localhost）
COMMENT_REPLY_URL_PREFIX=http://localhost:5173
