# MySQL配置
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=blog
MYSQL_USER=blog_user
MYSQL_PASSWORD=your_db_password

# Redis配置
REDIS_PASSWORD=your_redis_password

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random

# Docker镜像配置
BACKEND_IMAGE=registry.example.com/root/blog/backend:main
FRONTEND_IMAGE=registry.example.com/root/blog/frontend:main
ADMIN_IMAGE=registry.example.com/root/blog/admin:main
